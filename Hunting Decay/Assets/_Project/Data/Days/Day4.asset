%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d1aedb36125f514885767497710e5bb, type: 3}
  m_Name: Day4
  m_EditorClassIdentifier: Assembly-CSharp::HuntingDecay.DayData
  hasBreakfast: 1
  breakfastHealthy:
    greeting:
    - speaker: Daughter
      text: I dreamed about mama. She was singing.
    villageNews:
    - speaker: Daughter
      text: Hollis says Hollow Pine will make it through the winter.
    - speaker: Daughter
      text: But I'm not sure...
    - speaker: Daughter
      text: Papa...
  breakfastInfected:
    greeting:
    - speaker: Daughter
      text: Morning...
    - speaker: Daughter
      text: I need water, papa.
    villageNews:
    - speaker: Daughter
      text: The fever is in every house now.
    - speaker: Daughter
      text: Greer won't open her door anymore.
    - speaker: Daughter
      text: Papa...
  huntRequest:
  - speaker: Daughter
    text: There are people calling me from the woods.
  - speaker: Daughter
    text: They know my name.
  - speaker: Daughter
    text: They have mama's voice.
  - speaker: Daughter
    text: I'm scared.
  - speaker: Daughter
    text: Please come back today.
  scopeNote: 
  randomSounds: 1
  dinnerHealthy:
    question:
    - speaker: Daughter
      text: One of the voices stopped tonight.
    - speaker: Daughter
      text: Did you do something?
    replies:
    - text: I took care of it.
      reaction:
      - speaker: Daughter
        text: I knew you would.
      - speaker: Daughter
        text: You always do.
      - speaker: Daughter
        text: Please hunt the rest. They came inside while you were away.
    - text: Don't go into the woods. Promise me.
      reaction:
      - speaker: Daughter
        text: I promise.
  dinnerInfected:
    question:
    - speaker: Daughter
      text: There was a monster at the window.
    replies:
    - text: Lock the door tonight.
      reaction:
      - speaker: Daughter
        text: I did.
      - speaker: Daughter
        text: They said I'm next.
    - text: Come here. I'm home now.
      reaction:
      - speaker: Daughter
        text: You're so warm.
      - speaker: Daughter
        text: I'm cold all the time, papa.
  missedNews:
  - speaker: Daughter
    text: Hollis went missing.
  - speaker: Daughter
    text: Do you know where he is?
  colorFilter: {r: 0.9, g: 0.95, b: 1, a: 1}
  temperature: -20
  saturation: -25
  postExposure: -0.1
  customHuntGrade: 0
  huntTemperature: 0
  huntSaturation: 0
  huntPostExposure: 0
  foliageHue: 22
