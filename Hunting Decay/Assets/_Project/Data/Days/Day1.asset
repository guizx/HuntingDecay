  dinnerHealthy:
    question:
    - speaker: Daughter
      text: You're back! I kept the stew warm.
    - speaker: Daughter
      text: How was the forest today, Papa?
    replies:
    - text: Quiet. Too quiet.
      reaction:
      - speaker: Daughter
        text: Quiet is good, right? Quiet means nothing is chasing you.
    - text: I saw something I can't explain.
      reaction:
      - speaker: Daughter
        text: Like a ghost?
      - speaker: Daughter
        text: ...Tell me tomorrow. You look tired.
  dinnerInfected:
    question:
    - speaker: Daughter
      text: You're back.
    - speaker: Daughter
      text: I'm not very hungry tonight, Papa.
    replies:
    - text: Are you feeling alright?
      reaction:
      - speaker: Daughter
        text: Just tired. My arm itches a little.
    - text: Eat anyway. You need your strength.
      reaction:
      - speaker: Daughter
        text: I'll try. It tastes... green, somehow.
