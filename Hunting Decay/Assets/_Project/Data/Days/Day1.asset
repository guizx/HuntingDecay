  randomSounds: 1
  dinnerHealthy:
    question:
    - speaker: Daughter
      text: You're back! Venison stew, yay!
    - speaker: Daughter
      text: Thank you, papa!
    - speaker: Daughter
      text: How was the forest today?
    replies:
    - text: It was weird. I saw something I can't explain.
      reaction:
      - speaker: Daughter
        text: Like a ghost?
      - speaker: Daughter
        text: ...You look tired, papa. Tell me tomorrow, okay?
    - text: There was a deer with plants for eyes.
      reaction:
      - speaker: Daughter
        text: Plants for eyes? Really?
      - speaker: Daughter
        text: ...Are you okay, papa? You look tired. Rest a little, tell me more
          about it later.
  dinnerInfected:
    question:
    - speaker: Daughter
      text: You're back.
    - speaker: Daughter
      text: I'm not very hungry tonight, papa.
    replies:
    - text: Are you feeling alright?
      reaction:
      - speaker: Daughter
        text: Just tired. My arm itches a little.
    - text: Eat anyway. You need your strength.
      reaction:
      - speaker: Daughter
        text: I'll try. It tastes... green, somehow.
