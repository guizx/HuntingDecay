%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1d1aedb36125f514885767497710e5bb, type: 3}
  m_Name: Day2
  m_EditorClassIdentifier: Assembly-CSharp::HuntingDecay.DayData
  hasBreakfast: 1
  breakfastHealthy:
    greeting:
    - speaker: Daughter
      text: Morning, papa! Are you going to the forest today?
    - speaker: Daughter
      text: Some weird things happened.
    villageNews:
    - speaker: Daughter
      text: Hollis came by. He's a little sick, but he says Dr. Marsh is taking care
        of him.
    - speaker: Daughter
      text: He wants more meat to salt before the river freezes.
    - speaker: Daughter
      text: But Old Greer is worried about a fever going around.
    - speaker: Daughter
      text: She's calling it the bloom.
    - speaker: Daughter
      text: And the kids keep coughing. There's some green stuff on their hands.
  breakfastInfected:
    greeting:
    - speaker: Daughter
      text: Morning, papa.
    - speaker: Daughter
      text: I didn't sleep. My skin feels tight, like bark.
    villageNews:
    - speaker: Daughter
      text: But Old Greer is worried about a fever going around.
    - speaker: Daughter
      text: And the kids keep coughing. There's some green stuff on their hands.
  huntRequest:
  - speaker: Daughter
    text: They said they saw a figure in the trees, near some rags.
  - speaker: Daughter
    text: What's going on, papa? Hunt it, please!
  scopeNote: Shoot an anomaly if present.\nIf not, hunt the deer.
  randomSounds: 1
  dinnerHealthy:
    question:
    - speaker: Daughter
      text: Did you find anything?
    replies:
    - text: It's gone now.
      reaction:
      - speaker: Daughter
        text: Thank you, papa! I'll tell everyone tomorrow!
      - speaker: Daughter
        text: You're my hero!
    - text: Just an old tree. Eat your stew.
      reaction:
      - speaker: Daughter
        text: This is bread stew...
      - speaker: Daughter
        text: You make the same face mama made when she was hiding something.
  dinnerInfected:
    question:
    - speaker: Daughter
      text: You're back.
    - speaker: Daughter
      text: Sorry, papa. I can't stop shaking.
    replies:
    - text: What happened to you?
      reaction:
      - speaker: Daughter
        text: I think I got something from the forest.
      - speaker: Daughter
        text: I don't know what this is, papa. I'm scared.
    - text: I'll grab a blanket.
      reaction:
      - speaker: Daughter
        text: Thank you, papa.
      - speaker: Daughter
        text: I'm sorry.
      - speaker: Daughter
        text: I don't want to go away like mama.
  missedNews:
  - speaker: Daughter
    text: Old Greer came to the door today. She looked scared.
  - speaker: Daughter
    text: Hollis is coughing, and there's moss growing on his hands.
  - speaker: Daughter
    text: Dr. Marsh is trying his best.
  colorFilter: {r: 1, g: 0.95, b: 0.88, a: 1}
  temperature: 15
  saturation: -5
  postExposure: 0
  customHuntGrade: 0
  huntTemperature: 0
  huntSaturation: 0
  huntPostExposure: 0
  foliageHue: 28
  foliageHueAmount: 1
  foliageSaturation: 1
  foliageWhiten: 0
  weather: 1
  weatherRate: 8
  music: {fileID: 0}
  forestAmbience: {fileID: 11400000, guid: b26aa7a3ca111694fbda2beacdfe3832, type: 2}
